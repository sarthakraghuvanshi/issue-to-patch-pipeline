{
  "components": {
    "schemas": {
      "ApproveRequest": {
        "properties": {
          "decision": {
            "description": "approve | reject | revise",
            "title": "Decision",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "decision"
        ],
        "title": "ApproveRequest",
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "pass",
          "fail",
          "warn"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HypothesisOut": {
        "properties": {
          "cites": {
            "items": {
              "$ref": "#/components/schemas/SourceLocationOut"
            },
            "title": "Cites",
            "type": "array"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "summary",
          "confidence"
        ],
        "title": "HypothesisOut",
        "type": "object"
      },
      "PatchResponse": {
        "properties": {
          "base_sha": {
            "title": "Base Sha",
            "type": "string"
          },
          "changed_files": {
            "items": {
              "type": "string"
            },
            "title": "Changed Files",
            "type": "array"
          },
          "commit_sha": {
            "title": "Commit Sha",
            "type": "string"
          },
          "patch_text": {
            "title": "Patch Text",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "base_sha",
          "commit_sha",
          "changed_files",
          "patch_text"
        ],
        "title": "PatchResponse",
        "type": "object"
      },
      "RetrievalHitOut": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceLocationOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "score"
        ],
        "title": "RetrievalHitOut",
        "type": "object"
      },
      "RetrievalMode": {
        "enum": [
          "bm25",
          "dense",
          "hybrid"
        ],
        "title": "RetrievalMode",
        "type": "string"
      },
      "RetrievalResponse": {
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/RetrievalHitOut"
            },
            "title": "Evidence",
            "type": "array"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "evidence"
        ],
        "title": "RetrievalResponse",
        "type": "object"
      },
      "RunStateResponse": {
        "properties": {
          "changed_files": {
            "items": {
              "type": "string"
            },
            "title": "Changed Files",
            "type": "array"
          },
          "hypothesis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HypothesisOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "issue_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue Ref"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "description": "AWAITING_HUMAN_REVIEW, or a terminal RunState",
            "title": "Status",
            "type": "string"
          },
          "validation": {
            "items": {
              "$ref": "#/components/schemas/ValidationCheckOut"
            },
            "title": "Validation",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "status"
        ],
        "title": "RunStateResponse",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "commit_sha": {
            "title": "Commit Sha",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/RetrievalMode",
            "default": "hybrid"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "repo": {
            "title": "Repo",
            "type": "string"
          },
          "top_k": {
            "default": 10,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query",
          "repo",
          "commit_sha"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "candidates_considered": {
            "title": "Candidates Considered",
            "type": "integer"
          },
          "mode": {
            "$ref": "#/components/schemas/RetrievalMode"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResultOut"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "mode",
          "candidates_considered",
          "results"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SearchResultOut": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "line_end": {
            "title": "Line End",
            "type": "integer"
          },
          "line_start": {
            "title": "Line Start",
            "type": "integer"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          }
        },
        "required": [
          "rank",
          "score",
          "path",
          "line_start",
          "line_end",
          "symbol",
          "kind"
        ],
        "title": "SearchResultOut",
        "type": "object"
      },
      "SourceLocationOut": {
        "properties": {
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "line_end": {
            "title": "Line End",
            "type": "integer"
          },
          "line_start": {
            "title": "Line Start",
            "type": "integer"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          }
        },
        "required": [
          "chunk_id",
          "path",
          "line_start",
          "line_end"
        ],
        "title": "SourceLocationOut",
        "type": "object"
      },
      "StartRunRequest": {
        "properties": {
          "issue": {
            "description": "Issue URL, owner/repo#n, fixture path, or raw text",
            "title": "Issue",
            "type": "string"
          },
          "scope": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Glob(s) the patch must stay within",
            "title": "Scope"
          },
          "snapshot": {
            "description": "Path to an already-`index`ed snapshot directory",
            "title": "Snapshot",
            "type": "string"
          }
        },
        "required": [
          "issue",
          "snapshot"
        ],
        "title": "StartRunRequest",
        "type": "object"
      },
      "ValidatePatchRequest": {
        "properties": {
          "added_lines": {
            "default": 0,
            "title": "Added Lines",
            "type": "integer"
          },
          "allowed_scope": {
            "items": {
              "type": "string"
            },
            "title": "Allowed Scope",
            "type": "array"
          },
          "base_sha": {
            "title": "Base Sha",
            "type": "string"
          },
          "changed_files": {
            "items": {
              "type": "string"
            },
            "title": "Changed Files",
            "type": "array"
          },
          "commit_sha": {
            "title": "Commit Sha",
            "type": "string"
          },
          "patch_text": {
            "title": "Patch Text",
            "type": "string"
          },
          "removed_lines": {
            "default": 0,
            "title": "Removed Lines",
            "type": "integer"
          },
          "snapshot": {
            "description": "Path to the snapshot the patch was generated against",
            "title": "Snapshot",
            "type": "string"
          }
        },
        "required": [
          "snapshot",
          "base_sha",
          "commit_sha",
          "changed_files",
          "patch_text"
        ],
        "title": "ValidatePatchRequest",
        "type": "object"
      },
      "ValidatePatchResponse": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ValidationCheckOut"
            },
            "title": "Checks",
            "type": "array"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "checks"
        ],
        "title": "ValidatePatchResponse",
        "type": "object"
      },
      "ValidationCheckOut": {
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "ValidationCheckOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Turns a GitHub issue into a validated .patch file.",
    "title": "Issue-to-Patch Automation Pipeline",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/runs": {
      "post": {
        "operationId": "start_run_runs_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}": {
      "get": {
        "operationId": "get_run_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}/approve": {
      "post": {
        "operationId": "approve_run_runs__run_id__approve_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Approve Run",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}/patch": {
      "get": {
        "operationId": "get_patch_runs__run_id__patch_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Patch",
        "tags": [
          "runs"
        ]
      }
    },
    "/runs/{run_id}/retrieval": {
      "get": {
        "operationId": "get_retrieval_runs__run_id__retrieval_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrievalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Retrieval",
        "tags": [
          "runs"
        ]
      }
    },
    "/search": {
      "post": {
        "operationId": "search_search_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search",
        "tags": [
          "tools"
        ]
      }
    },
    "/validate-patch": {
      "post": {
        "operationId": "validate_patch_route_validate_patch_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidatePatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidatePatchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Validate Patch Route",
        "tags": [
          "tools"
        ]
      }
    }
  }
}
