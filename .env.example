# Copy to .env for local development. Never commit .env.
# All variables are prefixed ITP_ and map to issue_to_patch.config.Settings.

ITP_ENVIRONMENT=local
ITP_LOG_LEVEL=INFO
ITP_LOG_JSON=false

# Persistence (defaults to local SQLite + local Redis)
# ITP_DATABASE_URL=postgresql+psycopg://itp:itp@localhost:5432/itp
# ITP_REDIS_URL=redis://localhost:6379/0

ITP_ARTIFACTS_DIR=artifacts

# GitHub ingestion (Sprint 2+)
# ITP_GITHUB_TOKEN=ghp_xxx

# LLM provider: fake | anthropic | openai  (Sprint 5+ for real providers)
ITP_LLM_PROVIDER=fake
# ITP_LLM_API_KEY=
# ITP_LLM_MODEL=claude-sonnet-5

# Observability (Sprint 8+)
# ITP_LANGFUSE_HOST=http://localhost:3000
# ITP_LANGFUSE_PUBLIC_KEY=
# ITP_LANGFUSE_SECRET_KEY=
