# Copy to .env for local development. Never commit .env.
# All variables are prefixed ITP_ and map to issue_to_patch.config.Settings.

ITP_ENVIRONMENT=local
ITP_LOG_LEVEL=INFO
ITP_LOG_JSON=false

# Persistence (defaults to local SQLite + local Redis)
# ITP_DATABASE_URL=postgresql+psycopg://itp:itp@localhost:5432/itp
# ITP_REDIS_URL=redis://localhost:6379/0

ITP_ARTIFACTS_DIR=artifacts

# GitHub ingestion (Sprint 2+)
# ITP_GITHUB_TOKEN=ghp_xxx

# LLM provider: fake | anthropic | openai
ITP_LLM_PROVIDER=fake
# ITP_LLM_API_KEY=        # generic key; used if set, regardless of provider
# ITP_LLM_MODEL=          # optional; each provider has its own sensible default

# Or: set both provider-specific keys once, then flip ITP_LLM_PROVIDER above
# to switch which one is used — no need to re-paste a key each time.
# ITP_ANTHROPIC_API_KEY=sk-ant-...
# ITP_OPENAI_API_KEY=sk-...

# Reasoning engine (Sprint 7b): single (one LLM call per step) | multi (six
# specialist agents - Issue Analyst, Repository Cartographer, Root-Cause Analyst,
# Patch Author, Test Strategist, Patch Reviewer). Same graph either way.
ITP_AGENT_MODE=single

# API (Sprint 6). Required (not just recommended) outside local/ci — Settings
# refuses to start without it in staging/prod.
# ITP_API_KEY=
ITP_API_RATE_LIMIT_PER_MINUTE=60

# Observability (Sprint 8+)
# ITP_LANGFUSE_HOST=http://localhost:3000
# ITP_LANGFUSE_PUBLIC_KEY=
# ITP_LANGFUSE_SECRET_KEY=

# Push (the `auto` command's optional last step). A remote YOU OWN — e.g.
# your own fork — never the repo the issue came from. SSH form is preferred:
# it never embeds a credential in the URL, so there's nothing to leak via a
# process list or git's own error output. An https://<user>:<token>@...
# form also works but the token then sits in plain argv for the push.
# ITP_PUSH_REMOTE_URL=git@github.com:you/your-fork.git

# Embedding model for repository search; rebuild existing indexes after changing.
ITP_EMBEDDING_MODEL=text-embedding-3-large
